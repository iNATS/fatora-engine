{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fatora Invoice",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "currency",
    "totals",
    "line_items",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "invoice",
        "receipt",
        "credit_note",
        "unknown"
      ]
    },
    "document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "language_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supplier": {
      "$ref": "#/$defs/party"
    },
    "buyer": {
      "$ref": "#/$defs/party"
    },
    "invoice_number": {
      "$ref": "#/$defs/extractedString"
    },
    "issue_date": {
      "$ref": "#/$defs/extractedString"
    },
    "due_date": {
      "$ref": "#/$defs/extractedString"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "totals": {
      "type": "object",
      "required": [
        "subtotal",
        "tax",
        "total"
      ],
      "properties": {
        "subtotal": {
          "$ref": "#/$defs/money"
        },
        "tax": {
          "$ref": "#/$defs/money"
        },
        "discount": {
          "$ref": "#/$defs/money"
        },
        "fees": {
          "$ref": "#/$defs/money"
        },
        "total": {
          "$ref": "#/$defs/money"
        },
        "amount_paid": {
          "$ref": "#/$defs/money"
        },
        "balance_due": {
          "$ref": "#/$defs/money"
        }
      },
      "additionalProperties": false
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineItem"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "needs_review",
            "invalid"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "party": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tax_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "extractedString": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "money": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\\\.[0-9]+)?$"
    },
    "lineItem": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_price": {
          "$ref": "#/$defs/money"
        },
        "discount": {
          "$ref": "#/$defs/money"
        },
        "tax_rate": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_total": {
          "$ref": "#/$defs/money"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "field_path",
        "raw_text",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "field_path": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "raw_text": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
